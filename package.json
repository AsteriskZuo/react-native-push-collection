{
  "name": "react-native-push-collection",
  "version": "1.0.0",
  "description": "Get vendor push token.",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "readme": "docs/cn/index.md",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "docs",
    "src/version.ts",
    "*.podspec",
    "!lib/typescript/example",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace PushCollectionExample",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "yarn run lint:sdk && yarn run lint:example",
    "lint:sdk": "eslint \"src/**/*.{js,ts,tsx}\"",
    "lint:example": "eslint \"example/src/**/*.{js,ts,tsx}\"",
    "clean": "yarn run clean:generated && yarn run clean:node_modules",
    "clean:generated": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "clean:node_modules": "rm -rf example/node_modules && rm -rf node_modules/",
    "prepare": "yarn run gen:version_file && yarn run gen:env_file && yarn run build:exports",
    "gen:env_file": "cd scripts && node generate-env.js",
    "gen:version_file": "cd scripts && node generate-version.js",
    "gen:xcode:env": "echo export NODE_BINARY=$(command -v node) > example/ios/.xcode.env.local",
    "build:exports": "bob build",
    "yarn_pack": "mkdir build && yarn run prepare && yarn pack --out build/react-native-push-collection.tgz",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://github.com/easemob/react-native-push-collection",
  "author": "asteriskzuo <zuoyuhsywn@hotmail.com> (https://github.com/AsteriskZuo)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/easemob/react-native-push-collection/issues"
  },
  "homepage": "https://github.com/easemob/react-native-push-collection#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^17.0.2",
    "@evilmartians/lefthook": "^1.5.0",
    "@react-native/eslint-config": "^0.72.2",
    "@release-it/conventional-changelog": "^5.0.0",
    "@types/jest": "^28.1.2",
    "@types/react": "~17.0.21",
    "@types/react-native": "0.70.0",
    "commitlint": "^17.0.2",
    "del-cli": "^5.0.0",
    "eslint": "^8.4.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^28.1.1",
    "pod-install": "^0.1.0",
    "prettier": "^2.0.5",
    "react": "18.2.0",
    "react-native": "0.72.17",
    "react-native-builder-bob": "^0.20.0",
    "release-it": "^15.0.0",
    "turbo": "^1.10.7",
    "typescript": "^5.0.2"
  },
  "resolutions": {
    "@types/react": "17.0.21"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@3.6.1",
  "engines": {
    "node": ">= 16.16.1"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNPushCollectionSpec",
    "type": "modules",
    "jsSrcsDir": "src/__specs__",
    "android": {
      "javaPackageName": "com.pushcollection"
    }
  }
}
